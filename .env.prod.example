# Production profile
SPRING_PROFILES_ACTIVE=prod

# Render injects PORT automatically.
# Keep this only for local production-like testing.
PORT=8080
API_PORT=8080

# CORS
APP_CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app

# Neon PostgreSQL
DATABASE_URL=jdbc:postgresql://your-neon-host/complipilot?sslmode=require
DATABASE_USERNAME=your_neon_user
DATABASE_PASSWORD=your_neon_password

# JWT
JWT_SECRET=change_this_to_a_very_long_random_secret_at_least_64_chars
JWT_ISSUER=complipilot-backend
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=2592000
JWT_REFRESH_TOKEN_CLEANUP_FIXED_RATE_MS=3600000
JWT_REVOKED_REFRESH_TOKEN_RETENTION_SECONDS=604800

# Storage provider
STORAGE_PROVIDER=supabase

# Supabase Storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=complipilot-evidence-prod
SUPABASE_SIGNED_URL_EXPIRATION_SECONDS=900

# MinIO values are unused when STORAGE_PROVIDER=supabase
MINIO_ENDPOINT=
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_EVIDENCE=
MINIO_PRESIGNED_URL_EXPIRATION_MINUTES=15

# AI Service on Render
AI_SERVICE_BASE_URL=https://your-complipilot-ai-service.onrender.com

# Swagger
SPRINGDOC_ENABLED=false

# Rate limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_CAPACITY=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# Demo users
APP_DEMO_USERS_ENABLED=false

# App info
APP_VERSION=0.0.1-SNAPSHOT
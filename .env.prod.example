# App
API_PORT=8080
APP_CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# PostgreSQL
POSTGRES_DB=complipilot
POSTGRES_USER=complipilot
POSTGRES_PASSWORD=change_this_strong_database_password

# JWT
JWT_SECRET=change_this_to_a_very_long_random_secret_at_least_64_chars
JWT_ISSUER=complipilot-backend
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600

# MinIO
MINIO_ROOT_USER=complipilot
MINIO_ROOT_PASSWORD=change_this_strong_minio_password
MINIO_PUBLIC_ENDPOINT=https://your-minio-public-domain.com
MINIO_BUCKET_EVIDENCE=complipilot-evidence
MINIO_PRESIGNED_URL_EXPIRATION_MINUTES=15
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Swagger
SPRINGDOC_ENABLED=false